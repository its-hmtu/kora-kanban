# Copy to .env and fill in. Never commit real secrets.

# --- Core ---
DATABASE_URL=postgresql://kora:kora@localhost:5432/kora
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
SESSION_SECRET=
# 32-byte base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Object storage (Cloudflare R2; set S3_ENDPOINT to override, e.g. MinIO http://localhost:9000) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
S3_ENDPOINT=

# --- Email (dev: Mailpit SMTP on localhost:1025, UI on :8025) ---
RESEND_API_KEY=
MAIL_FROM=

# --- OAuth login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Web push (generate with: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- P4 integrations (placeholders) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
