{
  "$schema": "https://swc.rs/schema.json",
  "sourceMaps": true,
  "exclude": ["\\.spec\\.tsx?$"],
  "jsc": {
    "parser": { "syntax": "typescript", "decorators": true, "tsx": true },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true,
      "react": { "runtime": "automatic" }
    },
    "target": "es2023",
    "keepClassNames": true
  },
  "module": { "type": "commonjs" }
}
