{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "builder": { "type": "swc", "options": { "stripLeadingPaths": true } },
    "typeCheck": true,
    "deleteOutDir": true,
    "assets": [{ "include": "common/i18n/messages/*.json", "watchAssets": true }],
    "tsConfigPath": "tsconfig.build.json"
  }
}
